{
  "name": "NSH Todo",
  "id": "com.example.nshtodo",
  "icon": "assets/brand/icon-1024.png",
  "version": "1.0.0",
  "build": 1,
  "schemes": [
    "nshtodo"
  ],
  "theme": "theme.json",
  "rust": "rust",
  "ios": {
    "infoPlist": {
      "NSLocationWhenInUseUsageDescription": "NSH Todo shows your current position in Settings."
    }
  },
  "capabilities": {
    "network": {
      "hosts": [
        "api.exchange.coinbase.com",
        "ws-feed.exchange.coinbase.com"
      ]
    },
    "statusBar": true,
    "picker": true,
    "host": [
      "location.current"
    ]
  },
  "dependencies": {
    "nsh-icon": "^0.2.2",
    "nsh-icon-phosphor": "^0.2.2"
  }
}
